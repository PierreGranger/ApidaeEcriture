{
    "name": "pierre-granger/apidae-ecriture",
    "description": "Classe de simplification pour l'écriture sur Apidae",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.4",
        "pierre-granger/apidae-core": "^0.8.1"
    },
    "autoload": {
        "psr-4": {
            "PierreGranger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PierreGranger\\Ecriture\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit -c phpunit.xml.dist",
        "phpstan": "@php vendor/bin/phpstan analyse"
    }
}
